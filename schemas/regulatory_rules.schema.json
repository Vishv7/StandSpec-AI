{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegulatoryRulesRecord",
  "description": "Schema for Layer 3 regulatory and conformity knowledge records. Captures QCO mandates, BIS certification schemes, product manual references, and regulatory conflict resolution data.",
  "type": "object",
  "required": [
    "rule_id",
    "schema_version",
    "rule_type",
    "regulatory_status",
    "applicable_standards",
    "provenance"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "description": "Unique identifier for this regulatory rule (e.g. QCO_DPIIT_2023_ElectricalWires)."
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "quality_control_order",
        "product_certification_scheme",
        "product_manual",
        "ministry_notification",
        "hallmarking_regulation",
        "import_regulation"
      ],
      "description": "Type of regulatory rule."
    },
    "regulatory_status": {
      "type": "string",
      "enum": [
        "IN_FORCE",
        "DRAFT",
        "SUPERSEDED",
        "WITHDRAWN",
        "PARTIALLY_IN_FORCE",
        "UNKNOWN"
      ],
      "description": "Current status of this regulatory rule."
    },
    "issuing_authority": {
      "type": "object",
      "required": ["ministry", "department"],
      "properties": {
        "ministry": {
          "type": "string",
          "description": "Issuing ministry (e.g. 'Ministry of Commerce and Industry')."
        },
        "department": {
          "type": "string",
          "description": "Issuing department (e.g. 'Department for Promotion of Industry and Internal Trade (DPIIT)')."
        }
      },
      "additionalProperties": false
    },
    "order_details": {
      "type": "object",
      "properties": {
        "order_title": {
          "type": "string",
          "description": "Full title of the QCO or notification."
        },
        "order_number": {
          "type": ["string", "null"],
          "description": "Official order number (e.g. 'S.O. 1234(E)')."
        },
        "gazette_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date of Gazette notification."
        },
        "enforcement_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date from which the order is in force."
        },
        "expiry_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date of expiry if applicable."
        },
        "gazette_url": {
          "type": ["string", "null"],
          "description": "URL to the official Gazette notification."
        }
      },
      "additionalProperties": false
    },
    "certification_scheme": {
      "type": ["string", "null"],
      "enum": [
        null,
        "Scheme I",
        "Scheme II",
        "Scheme IV",
        "Scheme X",
        "Hallmarking",
        "Management Systems",
        "Other"
      ],
      "description": "BIS conformity assessment scheme. Scheme I = ISI Mark, Scheme II = CRS, etc."
    },
    "applicable_standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["standard_designation"],
        "properties": {
          "standard_designation": {
            "type": "string",
            "description": "Standard covered by this regulatory rule."
          },
          "product_description": {
            "type": ["string", "null"],
            "description": "Product or product group this standard covers under this rule."
          },
          "mandatory": {
            "type": "boolean",
            "description": "Whether compliance is legally mandatory under this rule."
          }
        },
        "additionalProperties": false
      },
      "description": "Standards covered by this regulatory rule."
    },
    "product_scope": {
      "type": ["object", "null"],
      "properties": {
        "products_covered": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of product types covered."
        },
        "hs_codes": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Harmonized System codes for import regulation."
        }
      },
      "additionalProperties": false
    },
    "exemptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["exemption_type", "description"],
        "properties": {
          "exemption_type": {
            "type": "string",
            "enum": [
              "export_only",
              "msme_grace_period",
              "existing_stock",
              "research_and_development",
              "government_use",
              "other"
            ]
          },
          "description": {
            "type": "string"
          },
          "clause_reference": {
            "type": ["string", "null"]
          },
          "expiry_date": {
            "type": ["string", "null"],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "additionalProperties": false
      },
      "description": "Exemptions from this regulatory requirement."
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["amendment_number", "date"],
        "properties": {
          "amendment_number": {"type": "integer"},
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "description": {"type": ["string", "null"]},
          "gazette_reference": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      },
      "description": "Amendments to this regulatory rule."
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflicting_rule_id", "conflict_type"],
        "properties": {
          "conflicting_rule_id": {
            "type": "string",
            "description": "ID of the conflicting regulatory rule."
          },
          "conflict_type": {
            "type": "string",
            "enum": [
              "overlapping_scope",
              "contradictory_requirement",
              "superseded_but_active",
              "ministry_jurisdictional"
            ]
          },
          "resolution": {
            "type": ["string", "null"],
            "description": "How the conflict should be resolved."
          },
          "resolution_source_tier": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 4
          }
        },
        "additionalProperties": false
      },
      "description": "Known conflicts with other regulatory rules."
    },
    "product_manual_reference": {
      "type": ["object", "null"],
      "properties": {
        "manual_title": {
          "type": "string",
          "description": "Title of the BIS Product Manual."
        },
        "sit_reference": {
          "type": ["string", "null"],
          "description": "Scheme of Inspection & Testing (SIT) document reference."
        },
        "sampling_plan": {
          "type": ["string", "null"],
          "description": "Sampling plan reference."
        },
        "critical_test_clauses": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Key test clause references from the product manual."
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_tier", "source_document", "verification_status"],
      "properties": {
        "source_tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "source_document": {
          "type": "string"
        },
        "source_url": {
          "type": ["string", "null"]
        },
        "verification_status": {
          "type": "string",
          "enum": ["VERIFIED", "UNVERIFIED", "CONTESTED", "PENDING_REVIEW"]
        },
        "extraction_timestamp": {
          "type": ["string", "null"]
        },
        "verified_by": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
