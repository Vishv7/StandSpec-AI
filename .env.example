# StandSpec AI — Environment Configuration
# Copy this file to `.env` in the project root and fill in your values.
# Note: Core StandSpec AI functions 100% offline hermetically without an LLM.

# ── LLM Configuration ──

# Enable live LLM assist (set to true to activate)
STANDSPEC_LLM_ENABLED=true

# Provider type: "gemini" (default) or "mock"
STANDSPEC_LLM_PROVIDER=gemini

# Your Google Gemini API Key (either variable name works)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# STANDSPEC_LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model identifier (gemini-3.8-flash)
STANDSPEC_LLM_MODEL=gemini-3.8-flash

# Bounded timeout in seconds (optional, default: 15)
STANDSPEC_LLM_TIMEOUT_SECONDS=15

# ── Server Configuration ──

# Server host and port
HOST=127.0.0.1
PORT=8000

# CORS allowed origins (comma-separated, no wildcard with credentials)
# Development: localhost frontend origins
# Production: set to your actual frontend domain(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Tender PDF Limits ──

# Maximum PDF file size in MB (default: 20)
MAX_PDF_SIZE_MB=20

# Maximum number of pages in a tender PDF (default: 200)
MAX_PDF_PAGES=200

# ── Python Path ──
PYTHONPATH=.
